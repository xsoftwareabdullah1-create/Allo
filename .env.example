# Allo web login (required when NODE_ENV=production)
ALLO_USERNAME=admin
ALLO_PASSWORD=replace-with-a-long-random-password

# Optional API key for OpenAI-compatible SDK clients using Bearer authentication
ALLO_API_KEY=replace-with-a-separate-random-api-key

# Docker Compose uses the Ollama service hostname internally
OLLAMA_BASE_URL=http://ollama:11434
PORT=3000
NODE_ENV=production
