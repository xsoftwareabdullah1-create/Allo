# Allo web login (required in production)
ALLO_USERNAME=admin
ALLO_PASSWORD=replace-with-a-long-random-password

# Optional API key for OpenAI-compatible SDK clients
ALLO_API_KEY=replace-with-a-separate-random-api-key

# Native Allo runtime settings
PORT=3000
NODE_ENV=production
ALLO_MAX_LOADED_MODELS=1
ALLO_CONTEXT_SIZE=4096
ALLO_GPU_LAYERS=0
ALLO_MAX_MODEL_BYTES=53687091200

# Required to encrypt cloud provider API keys at rest (generate: openssl rand -hex 32)
ALLO_ENCRYPTION_KEY=replace-with-a-long-random-32-byte-secret
